# The AI detective and voice input (Scribe v2), both through the Vercel AI Gateway: https://vercel.com/ai-gateway
AI_GATEWAY_API_KEY=

# Optional: web search inside the detective's answers (Parallel): https://parallel.ai
PARALLEL_WEB_SEARCH_KEY=

# Optional: only needed to re-download GRACE data with scripts/grace-to-grid.py (NASA Earthdata)
EARTHDATA_TOKEN=

# Optional: Piper voice for spoken answers (`npm run voice`); without it the browser's voice speaks
# VOICE_URL=http://127.0.0.1:8765

# Optional: LangSmith tracing of each detective answer
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=
